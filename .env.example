# 5G Emergency Response Network - Environment Variables Configuration

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
WS_PORT=3001

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=emergency_network
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ============================================================================
# AUTHENTICATION & JWT CONFIGURATION
# ============================================================================
# Generate these using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-32-chars-min
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-32-chars-min

# Token expiration
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# ENCRYPTION CONFIGURATION
# ============================================================================
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=your-encryption-master-key-change-in-production-32-chars-min

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# HTTPS/TLS
HTTPS_ENABLED=false
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Login attempts
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=1800000

# ============================================================================
# EMAIL CONFIGURATION (For password reset, notifications, etc.)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@emergency-response.com
SMTP_SECURE=true

# ============================================================================
# AUDIT LOGGING
# ============================================================================
# Enable detailed audit logging
AUDIT_LOGGING_ENABLED=true

# HIPAA compliance mode (stricter audit trails)
HIPAA_MODE=true

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# Google Maps API (for routing and mapping)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Twilio (for SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
REACT_APP_API_URL=http://localhost:3000/api
REACT_APP_WS_URL=ws://localhost:3001

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info
LOG_FILE=/var/log/emergency-response/app.log

# Sentry (error tracking)
SENTRY_DSN=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_TWO_FACTOR_AUTH=true
FEATURE_API_KEYS=true
FEATURE_DATA_EXPORT=false
FEATURE_ADVANCED_REPORTING=true

# ============================================================================
# DEVELOPMENT/TESTING
# ============================================================================
# Enable demo/test data
USE_DEMO_DATA=true

# API documentation
API_DOCS_ENABLED=true

# Security headers (set to false in development if needed)
SECURITY_HEADERS_ENABLED=true
