    "ws": "^8.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "axios": "^1.4.0",
    "uuid": "^9.0.0",
    "pg": "^8.11.3",
    "pg-pool": "^3.6.1",
    "pg-migrate": "^0.4.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0"
  }
